# --- Required ---

# PostgreSQL connection string (Neon, Supabase, Railway, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/scanverify"

# JWT signing secret — any long random string. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# --- Optional (only needed once you move off local-disk image storage) ---

# File storage (choose one; see README "Image storage in production")
CLOUDINARY_URL=""
# or
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Optional (only needed once you swap the mock AI for a real model) ---

OPENAI_API_KEY=""
GOOGLE_VISION_API_KEY=""
